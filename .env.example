# Copiá este archivo como .env y completá los valores reales.
# El .env NO se sube al repo (está en .gitignore).

# Puerto del servidor
PORT=4000

# URL del front (necesaria para CORS). En desarrollo es el puerto de Vite.
CLIENT_URL=http://localhost:5173

# Base de datos
MONGO_URI=tu_string_de_conexion_de_mongodb_atlas

# Autenticación
JWT_SECRET=tu_secreto_jwt

# Cloudinary (subida de imágenes)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# SMTP (envío de mails). En desarrollo se puede usar Ethereal.
# Para Gmail real: SMTP_HOST=smtp.gmail.com y SMTP_PASS = contraseña de aplicación.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_smtp
SMTP_SECURE=false
