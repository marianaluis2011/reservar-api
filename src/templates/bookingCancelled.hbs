<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Reserva cancelada</title>
  </head>
  <body>
    <div>
      <h1>Reserva cancelada</h1>
      <p>Hola {{fullName}},</p>
      <p>Tu reserva fue cancelada correctamente.</p>
      <p>Hospedaje: {{accommodationName}}</p>
      <p>Habitación: {{roomName}}</p>
